---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const { title = "猫太博客 | 2026 机场推荐与稳定梯子选购指南", description = "猫太博客 - 关注 2026 翻墙机场推荐、IEPL/IPLC 专线测评、免费美区 Apple ID 与跨境出海技术选型。" } = Astro.props;

const siteUrl = 'https://maotaiblog.com';
const canonicalURL = Astro.props.canonical || new URL(Astro.url.pathname, siteUrl).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "猫太博客",
  "url": siteUrl,
  "description": description,
  "publisher": {
    "@type": "Organization",
    "name": "猫太博客",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo.png`
    }
  }
};
---

<!DOCTYPE html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- 强制全量浏览器更新二次元少女 Favicon 图标 -->
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />

    <!-- 规范 Canonical 标签防止权重分散 -->
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (OG) 默认标签 -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${siteUrl}/gallery/retro-cat-girl.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 站点基础 JSON-LD 结构化标记 -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-color)] text-[var(--text-main)]">
    <!-- 1. 顶部导航栏 -->
    <Navbar />

    <!-- 2. 核心主体内容区域 (flex-1 自动撑开视口高度) -->
    <main class="mx-auto flex-1 w-full max-w-7xl px-4 pt-6 pb-12">
      <slot />
    </main>

    <!-- 3. 底部页脚 (必须严格位于 main 之后) -->
    <Footer />

    <!-- 全局 ⌘K 站内搜索 Modal 弹窗 -->
    <SearchModal />
  </body>
</html>
