const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "为什么共享美区 Apple ID 账号会被锁定？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "共享 Apple ID 被锁主要有两种原因：一是部分不合规使用者误将账号登录到了 iOS 系统【设置】(iCloud)，触发了 Apple 的双重认证或防盗机制；二是短时间内异地异网络频繁登录同一个账号，触发了苹果风控系统的安全防护保护性封锁。"
      }
    },
    {
      "@type": "Question",
      "name": "从共享账号下载的 App (如 Shadowrocket) 后续如何更新？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "iOS 系统规定只有用购买该应用时的原始 Apple ID 才能进行版本更新。当提示更新时，只需在 App Store 中暂退当前账号，重新登录我们提供的最新共享账号，点击‘已购项目’再次找到该 App 即可免费覆盖更新。"
      }
    }
  ]
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

  <div class="flex flex-col gap-6 lg:flex-row items-start">
    <Sidebar />

    <section class="flex-1 flex flex-col gap-6 w-full min-w-0">
      <!-- SEO 引言文章 Header (浅色马卡龙风格卡片) -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-white/95 p-6 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:bg-[#1A1523]/95">
        <div class="flex items-center gap-2 mb-3 flex-wrap">
          <span class="rounded-full bg-pink-100 border border-pink-200 px-3 py-1 font-mono text-xs font-black text-pink-600 dark:bg-purple-900 dark:text-pink-200">
            🔥 2026 实时更新
          </span>
          <span class="rounded-full bg-emerald-100 border border-emerald-300 px-3 py-1 font-mono text-xs font-black text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
            🟢 探针自动巡检
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#3C2C26] dark:text-pink-100 leading-tight">
          免费美区 Apple ID 共享账号大全
        </h1>

        <!-- SEO 引言文案 -->
        <div class="mt-4 text-xs sm:text-sm text-[#7A6860] dark:text-pink-200/90 font-medium leading-relaxed space-y-3 border-t border-pink-100 dark:border-purple-900/60 pt-4">
          <p>
            欢迎使用猫太博客提供的<strong>免费美区 Apple ID 共享账号</strong>服务。本页面专为需要下载 <strong>Shadowrocket (小火箭)</strong>、Quantumult X、Stash 以及各类 <strong>iOS 外区账号</strong> 专属软件的用户打造。我们通过后台 Python 探针脚本进行 24 小时无人值守巡检，自动下架因异常操作被封禁的节点，确保列表中全量呈现可用账号。
          </p>
          <div class="rounded-2xl bg-rose-50/90 border-2 border-rose-300/80 p-3.5 text-rose-800 font-bold text-xs sm:text-sm dark:bg-rose-950/40 dark:text-rose-200 dark:border-rose-800">
            🚨 <strong>极危风控警告：</strong>
            共享账号<strong>严禁从 iPhone / iPad 的系统【设置】登录 iCloud</strong>！请严格仅在 App Store 软件内点击右上角头像进行登录。误登系统 iCloud 将导致您的设备被云端绑架与死锁！
          </div>
        </div>
      </div>

      <!-- 核心 AccountPool 组件 (全浅色粉彩美学) -->
      <AccountPool />

      <!-- SEO FAQ 专业解答文案区块 -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-white/95 p-6 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:bg-[#1A1523]/95 space-y-6">
        <h2 class="text-xl font-black text-[#3C2C26] dark:text-pink-100 flex items-center gap-2 border-b border-pink-100 dark:border-purple-900/60 pb-3">
          <span>❓ 常见问题与外区 iOS 账号安全使用 FAQ</span>
        </h2>

        <div class="space-y-4 text-xs sm:text-sm leading-relaxed">
          <div class="rounded-2xl bg-pink-50/70 p-4 border border-pink-100 dark:bg-purple-950/50 dark:border-purple-900/60">
            <h3 class="font-black text-pink-600 dark:text-pink-300 text-sm mb-1.5">Q1: 为什么共享 Apple ID 账号会被锁定？</h3>
