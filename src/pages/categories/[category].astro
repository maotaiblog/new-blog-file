---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostCard from '../../components/PostCard.astro';
import AirportRankTable from '../../components/AirportRankTable.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  const categoryMap: Record<string, string[]> = {
    '测评': ['测评', 'reviews', '机场测评'],
    'reviews': ['测评', 'reviews', '机场测评'],
    '教程': ['教程', 'tutorials', '技术指南'],
    'tutorials': ['教程', 'tutorials', '技术指南'],
    '自托管': ['自托管', 'self-hosted', 'Docker'],
    'self-hosted': ['自托管', 'self-hosted', 'Docker'],
    '什么值得买': ['什么值得买', 'deals', '福利'],
    'deals': ['什么值得买', 'deals', '福利']
  };

  return Object.keys(categoryMap).map(category => ({
    params: { category },
    props: { 
      categoryName: category,
      matches: categoryMap[category]
    },
  }));
}

const { categoryName, matches } = Astro.props;
const allPosts = await getCollection('blog');

const filteredPosts = allPosts.filter(post => 
  matches.some((m: string) => 
    post.data.category.toLowerCase() === m.toLowerCase() || 
    post.data.tags?.some((t: string) => t.toLowerCase() === m.toLowerCase())
  )
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const isReviewCategory = ['测评', 'reviews', '机场测评'].includes(categoryName);
---

<BaseLayout title={`分类：${categoryName} - 猫太博客`}>
  <div class="flex flex-col gap-6 md:flex-row">
    <!-- 左侧固定边栏 -->
    <Sidebar />

    <!-- 右侧内容区域 -->
    <div class="flex-1 flex flex-col gap-6">
      <!-- 页面顶部 Header Banner -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-gradient-to-r from-pink-100/70 via-purple-100/50 to-sky-100/70 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:from-purple-950/60 dark:to-pink-950/40">
        <div class="flex items-center gap-4">
          <span class="text-4xl filter drop-shadow-md">📁</span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-black text-[#3C2C26] dark:text-pink-100">
              分类目录：{categoryName}
            </h1>
            <p class="mt-1 text-xs sm:text-sm font-bold text-pink-600 dark:text-pink-300">
              共筛选出 <span class="font-mono text-base font-black">{filteredPosts.length}</span> 篇相关文章
            </p>
          </div>
        </div>
      </div>

      <!-- 如果是“测评”分类，展示规范 8 列排行榜组件大盘 -->
      {isReviewCategory && (
        <div class="flex flex-col gap-3">
          <div class="flex items-center justify-between px-1">
            <h2 class="text-xl sm:text-2xl font-black text-[#3C2C26] dark:text-pink-100 flex items-center gap-2">
              <span>⚡ 2026 全量 18 家机场选型大盘 (8列规范版)</span>
            </h2>
            <a href="/rank" class="text-xs font-bold text-pink-600 dark:text-pink-300 hover:underline">
              查看独立榜单页 ➔
            </a>
          </div>
          <AirportRankTable />
        </div>
      )}

      <!-- 文章卡片列表 -->
      <div class="flex flex-col gap-5">
        {filteredPosts.map(post => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.pubDate.toISOString().slice(0, 10)}
            category={post.data.category}
            readTime={post.data.readTime}
            slug={post.slug}
          />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
