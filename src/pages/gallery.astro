---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const galleryItems = [
  {
    id: 'sunset',
    title: '夕阳咖啡馆与热奶茶的双马尾日常',
    styleTag: '🌸 日常治愈',
    subtitle: 'Tranquil Afternoon Milk Tea',
    imageSrc: '/gallery/sunset.jpg', // 对应 public/gallery/sunset.jpg
    prompt: 'masterpiece, best quality, 1girl, modern slice of life anime style, dark brown hair in twin tails, warm amber eyes, Japanese high school...'
  },
  {
    id: 'retro-cat',
    title: '90s 复古波斯白猫与金发少女',
    styleTag: '🌸 90s 复古漫风',
    subtitle: '90s Nostalgic Anime Girl & White Cat',
    imageSrc: '/gallery/retro-cat.jpg', // 对应 public/gallery/retro-cat.jpg
    prompt: 'masterpiece, best quality, 1girl, 90s anime style, fluffy white cat, golden blonde hair...'
  }
];
---

<BaseLayout title="精选二次元插画图库 - 猫太博客" description="展示 90s 复古日漫风与治愈系二次元精选插画图库画廊。">
  <div class="flex flex-col gap-6 md:flex-row">
    <!-- 左侧固定边栏 -->
    <Sidebar />

    <!-- 右侧图库大盘区域 -->
    <div class="flex-1 flex flex-col gap-6">
      
      <!-- 1. Banner 标题卡片 -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-gradient-to-r from-pink-100/70 via-purple-100/50 to-sky-100/70 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:from-purple-950/60 dark:to-pink-950/40">
        <div class="flex items-center gap-4">
          <span class="text-4xl sm:text-5xl filter drop-shadow-md">🖼️</span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-black text-[#3C2C26] dark:text-pink-100">
              猫太博客 • 治愈系画廊图库
            </h1>
            <p class="mt-1 text-xs sm:text-sm font-bold text-pink-600 dark:text-pink-300">
              90s Retro Anime & Slice of Life Gallery • 共收录 {galleryItems.length} 张精选画作
            </p>
          </div>
        </div>
      </div>

      <!-- 2. 图库瀑布流 / 拍立得网格大盘 -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        {galleryItems.map(item => (
          <div class="group relative flex flex-col rounded-3xl border-2 border-pink-200/60 bg-white/90 p-5 shadow-pastel-glow backdrop-blur-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_15px_35px_rgba(255,183,178,0.45)] dark:border-purple-800/50 dark:bg-[#1A1523]/90">
            <!-- 拍立得照片框 -->
            <div class="relative overflow-hidden rounded-2xl border border-pink-100 bg-pink-50 dark:border-purple-900 dark:bg-purple-950/50">
              <img
                src={item.imageSrc}
                alt={item.title}
                class="h-56 sm:h-64 w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-black text-pink-600 shadow-md backdrop-blur-md dark:bg-purple-900/90 dark:text-pink-200">
                {item.styleTag}
              </span>
            </div>

            <!-- 描述信息 -->
            <div class="mt-4 flex flex-col gap-1">
              <h2 class="text-lg font-black text-[#3C2C26] dark:text-pink-100 group-hover:text-pink-500 transition-colors">
                {item.title}
              </h2>
              <p class="font-mono text-xs font-bold text-pink-400 dark:text-pink-300">
                {item.subtitle}
              </p>
            </div>

            <!-- Prompt 窥探模块 -->
            <div class="mt-3 rounded-xl bg-pink-50/70 p-3 dark:bg-purple-950/50 border border-pink-100 dark:border-purple-900/60">
              <p class="font-mono text-[11px] text-[#7A6860] line-clamp-2 dark:text-pink-200/80 leading-tight">
                <span class="font-bold text-pink-600 dark:text-pink-300">Prompt:</span> {item.prompt}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>
