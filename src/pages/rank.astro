---
import BaseLayout from '../layouts/BaseLayout.astro';
import AirportRankTable, { airportsData } from '../components/AirportRankTable.astro';
import Sidebar from '../components/Sidebar.astro';

const siteUrl = 'https://maotaiblog.com';
const pageTitle = "2026 机场推荐与稳定梯子选购对比大盘 (8列规范全量版) - 猫太博客";
const pageDescription = "全网最客观权威的 2026 机场推荐与梯子选购榜单。基于 24/7 分布式探针连续 72 小时实测，提供 IPLC 专线、BGP 中转线路、丢包率与 AI 流媒体解锁矩阵对比。";

// 结构化 JSON-LD 数据构建
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "2026年翻墙机场怎么选最稳定？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "建议优先选择采用 IPLC 或 IEPL 内网专线架构的机场，这类线路不经过公网防火墙，晚高峰时段丢包率低且延迟稳定。"
      }
    },
    {
      "@type": "Question",
      "name": "什么是原生 IP？为什么解锁 ChatGPT 需要它？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "原生 IP 是指 IP 注册地与服务器机房物理所在地一致的 IP。OpenAI 等服务对数据中心 IP 封控严格，使用原生住宅 IP 能大幅降低被封禁风险。"
      }
    },
    {
      "@type": "Question",
      "name": "机场跑路风险如何规避？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "坚守“月付保平安”原则，不买长周期高折扣年付套餐，并配置一主一备双服务商节点。"
      }
    }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": airportsData.map((item, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": item.name,
    "url": `${siteUrl}${item.reviewUrl}`
  }))
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>

  <div class="flex flex-col gap-6 lg:flex-row items-start">
    <Sidebar />

    <section class="flex-1 flex flex-col gap-6 w-full min-w-0">
      <!-- 1. Above-the-Fold 标题 Header & 时效性 Banner -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-white/95 p-6 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:bg-[#1A1523]/95">
        <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-pink-100 px-3 py-1 text-xs font-black text-pink-600 dark:bg-purple-900 dark:text-pink-200">
              🏆 E-E-A-T 独立测评大盘
            </span>
            <!-- 📅 时效性信任 Banner -->
            <span class="rounded-full bg-emerald-100 px-3 py-1 font-mono text-xs font-extrabold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
              📅 数据最后更新于：2026年8月28日
            </span>
          </div>
          <span class="font-mono text-xs text-pink-400 font-bold">24/7 PROBE MONITORING</span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#3C2C26] dark:text-pink-100 leading-tight">
          2026 机场推荐与选型对比大盘
        </h1>
        <p class="mt-2 text-xs sm:text-sm font-medium text-[#7A6860] dark:text-pink-200/90 leading-relaxed">
          基于全网分布式探针 72 小时轮询采集，涵盖 IPLC 专线、BGP 中转、晚高峰丢包率、起步价格与 ChatGPT 原生解封表现。
        </p>
      </div>

      <!-- 2. 排行榜表格 (内置机场智能选购筛选器) -->
      <AirportRankTable />

      <!-- 3. E-E-A-T 信任背书与白皮书入口 -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-gradient-to-r from-pink-100/60 to-purple-100/50 p-6 shadow-sm dark:border-purple-800 dark:from-purple-950/60 dark:to-pink-950/40">
        <div class="flex items-center gap-4">
          <span class="text-3xl filter drop-shadow-md">📘</span>
          <div>
            <h3 class="text-lg font-black text-[#3C2C26] dark:text-pink-100">
              想深入了解 5 维定量打分拓扑模型与测试脚本？
            </h3>
            <p class="mt-1 text-sm font-medium text-[#7A6860] dark:text-pink-200/90">
              查阅我们的 10,000 字白皮书规范：
              <a href="/blog/airport-evaluation-whitepaper-full-2026" class="inline-flex items-center gap-1 font-black text-pink-600 dark:text-pink-300 underline hover:text-pink-700 ml-1">
                <span>👉 2026 机场测评定量打分与白皮书 v4.2 权威标准版</span>
                <span>➔</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
