---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

const allPosts = await getCollection('blog');

// 计算所有标签及其出现频次
const tagCounts = allPosts.reduce((acc: Record<string, number>, post) => {
  post.data.tags?.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签云 - 猫太博客" description="按标签云汇总查看所有机场测评与技术指南。">
  <div class="flex flex-col gap-6 md:flex-row">
    <Sidebar />

    <div class="flex-1 flex flex-col gap-6">
      <div class="rounded-3xl border-2 border-pink-200/80 bg-gradient-to-r from-pink-100/70 via-purple-100/50 to-sky-100/70 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:from-purple-950/60 dark:to-pink-950/40">
        <div class="flex items-center gap-4">
          <span class="text-4xl filter drop-shadow-md">🏷️</span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-black text-[#3C2C26] dark:text-pink-100">
              全站标签云目录
            </h1>
            <p class="mt-1 text-xs sm:text-sm font-bold text-pink-600 dark:text-pink-300">
              共汇总 <span class="font-mono text-base font-black">{sortedTags.length}</span> 个热门标签
            </p>
          </div>
        </div>
      </div>

      <!-- 标签云面板 -->
      <div class="rounded-3xl border-2 border-pink-200/60 bg-white/90 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/50 dark:bg-[#1A1523]/90 flex flex-wrap gap-3">
        {sortedTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}`}
            class="group inline-flex items-center gap-2 rounded-full border border-pink-200 bg-pink-50/80 px-4 py-2 text-xs sm:text-sm font-bold text-[#3C2C26] shadow-sm transition-all hover:bg-pink-300 hover:text-white hover:scale-105 active:scale-95 dark:border-purple-800 dark:bg-purple-900/60 dark:text-pink-100 dark:hover:bg-purple-700"
          >
            <span>🏷️ {tag}</span>
            <span class="rounded-full bg-pink-200 px-2 py-0.5 font-mono text-[11px] font-extrabold text-pink-700 group-hover:bg-white group-hover:text-pink-600 dark:bg-purple-800 dark:text-pink-200">
              {count}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
