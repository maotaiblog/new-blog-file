---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // 提取全量文章年份
  const years = Array.from(new Set(allPosts.map(post => post.data.pubDate.getFullYear().toString())));

  return years.map(year => ({
    params: { year },
    props: { year },
  }));
}

const { year } = Astro.props;
const allPosts = await getCollection('blog');

// 过滤指定年份并按时间降序
const yearPosts = allPosts
  .filter(post => post.data.pubDate.getFullYear().toString() === year)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={`📅 ${year} 年文章归档 - 猫太博客`} description={`查看猫太博客在 ${year} 年上传发布的所有精选长文与技术指南。`}>
  <div class="flex flex-col gap-6 md:flex-row">
    <!-- 左侧固定边栏 -->
    <Sidebar />

    <!-- 右侧时间轴归档区域 -->
    <div class="flex-1 flex flex-col gap-6">
      
      <!-- Banner 标题卡片 -->
      <div class="rounded-3xl border-2 border-pink-200/80 bg-gradient-to-r from-pink-100/70 via-purple-100/50 to-sky-100/70 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/60 dark:from-purple-950/60 dark:to-pink-950/40">
        <div class="flex items-center gap-4">
          <span class="text-4xl filter drop-shadow-md">📅</span>
          <div>
            <h1 class="text-2xl sm:text-3xl font-black text-[#3C2C26] dark:text-pink-100">
              {year} 年文章归档目录
            </h1>
            <p class="mt-1 text-xs sm:text-sm font-bold text-pink-600 dark:text-pink-300">
              该年份共计上传 <span class="font-mono text-base font-black">{yearPosts.length}</span> 篇精选长文
            </p>
          </div>
        </div>
      </div>

      <!-- 返回全量归档按钮 -->
      <div class="px-1">
        <a
          href="/archives"
          class="inline-flex items-center gap-1.5 rounded-full border border-pink-200 bg-white/90 px-4 py-1.5 text-xs font-black text-pink-600 shadow-sm transition-all hover:bg-pink-100 hover:scale-105 dark:border-purple-800 dark:bg-purple-900/60 dark:text-pink-200"
        >
          <span>← 查看全量年份总时间轴</span>
        </a>
      </div>

      <!-- 时间轴 UI -->
      <div class="rounded-3xl border-2 border-pink-200/60 bg-white/90 p-6 sm:p-8 shadow-pastel-glow backdrop-blur-md dark:border-purple-800/50 dark:bg-[#1A1523]/90">
        <h2 class="text-xl sm:text-2xl font-black text-[#3C2C26] dark:text-pink-100 flex items-center gap-2 border-b-2 border-pink-100 dark:border-purple-900/60 pb-3 mb-6">
          <span>📅 {year} 年发布历史</span>
          <span class="rounded-full bg-pink-100 text-pink-600 px-3 py-0.5 font-mono text-xs font-bold dark:bg-purple-900 dark:text-pink-200">
            {yearPosts.length} 篇
          </span>
        </h2>

        <ul class="border-l-2 border-pink-200/80 dark:border-purple-800/80 pl-4 sm:pl-6 ml-2 flex flex-col gap-4 list-none">
          {yearPosts.map(post => {
            const monthDay = post.data.pubDate.toISOString().slice(5, 10);
            return (
              <li class="relative flex items-center gap-3 sm:gap-4 group">
                <span class="absolute -left-[23px] sm:-left-[31px] top-1/2 -translate-y-1/2 h-3 w-3 rounded-full border-2 border-pink-300 bg-white group-hover:bg-pink-400 group-hover:scale-125 transition-all dark:bg-purple-950 dark:border-purple-600"></span>

                <span class="font-mono text-xs sm:text-sm font-extrabold text-pink-500 dark:text-pink-300 shrink-0">
                  {monthDay}
                </span>

                <span class="rounded-full bg-pink-50 border border-pink-200 px-2.5 py-0.5 font-sans text-[11px] font-bold text-pink-600 dark:bg-purple-950 dark:border-purple-800 dark:text-pink-200 shrink-0 hidden sm:inline">
                  {post.data.category}
                </span>

                <a
                  href={`/blog/${post.slug}`}
                  class="text-sm sm:text-base font-bold text-[#3C2C26] transition-colors group-hover:text-pink-600 dark:text-pink-100 dark:group-hover:text-pink-300 line-clamp-1"
                >
                  {post.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

    </div>
  </div>
</BaseLayout>
