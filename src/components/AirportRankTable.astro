export interface AirportUnlockDetails {
  chatGPT: boolean;
  claude: boolean;
  netflix: boolean;
  disneyPlus: boolean;
}

export interface AirportRankItem {
  id: string;
  rank: number;
  name: string;
  architecture: string;       // 线路架构（IEPL/IPLC/BGP中转/直连）
  packetLoss: string;         // 晚高峰丢包率（如 <0.1%）
  startingPrice: string;      // 起步价格（如 "28元"）
  priceVal: number;           // 数字价格（如 28）
  traffic: string;            // 起步套餐流量（如 "150G/月"）
  cheapestPlan: string;       // 合并格式如 "28元 150G/月"
  protocols: string[];        // 支持协议（如 ["Shadowsocks", "Hysteria 2", "VLESS", "Trojan"]）
  regions: string[];          // 节点覆盖（如 ["港", "台", "日", "韩", "美", "新加坡"]）
  unlockDetails: AirportUnlockDetails; // 流媒体与 AI 解锁细分
  deviceLimit: string;        // 同时在线设备数（如 "无限制" 或 "5 台"）
  maxSpeed: string;           // 峰值测速带宽（如 "1000Mbps"）
  paymentMethods: string[];   // 支付方式（如 ["支付宝", "微信", "USDT"]）
  tags: string[];             // 特点标签（如 ["原生住宅IP", "8K秒开", "低延迟游戏"]）
  officialUrl: string;        // 从 md 档案提取的真实官网直达外链
  reviewUrl: string;          // 站内独立测评文章链接
  change: string;             // 排名升降标识 ("-" | "↑1" | "↑11" | "↓1")
  universalSub: boolean;      // 通用订阅 (✓ / ✕)
  noTimeLimit: boolean;       // 不限时 (✓ / ✕)
  tgGroupUrl?: string;        // TG群组链接
}

