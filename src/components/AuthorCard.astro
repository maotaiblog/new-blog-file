---
---

<div
  class="group relative flex flex-col items-center rounded-3xl border-2 border-pink-200/60 bg-white/80 p-6 shadow-pastel-glow backdrop-blur-md transition-all duration-300 hover:shadow-[0_15px_35px_rgba(255,183,178,0.45)] dark:border-purple-800/50 dark:bg-[#1A1523]/85"
>
  <!-- 拍立得贴纸风格头像区域 -->
  <div class="polaroid-frame relative">
    <div class="h-32 w-32 overflow-hidden rounded-lg bg-pink-100">
      <img
        src="/gallery/retro-cat-girl.jpg"
        alt="猫太博客 90s 复古动漫头像"
        class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-110"
      />
    </div>
    <div
      class="absolute inset-0 flex items-center justify-center bg-pink-400/20 opacity-0 backdrop-blur-[2px] transition-all duration-300 group-hover:opacity-100 rounded-lg"
    >
      <span class="text-3xl filter drop-shadow-md">🎀</span>
    </div>
  </div>

  <!-- 个人信息 -->
  <h2 class="mt-4 text-2xl font-black tracking-wide text-[#3C2C26] dark:text-pink-100 flex items-center gap-1.5">
    <span>猫太博客</span>
    <span class="text-lg">🐔</span>
  </h2>

  <!-- 蜜桃粉中心短指示条 -->
  <div class="my-2.5 h-1.5 w-12 rounded-full bg-gradient-to-r from-pink-300 to-sky-200 shadow-sm"></div>

  <!-- 签名 -->
  <p class="text-center font-mono text-sm italic font-semibold text-[#7A6860] dark:text-pink-200/80">
    "𝙄𝙩'𝙨 𝙩𝙝𝙚 𝙤𝙣𝙡𝙮 𝙉𝙀𝙀𝙏 𝙩𝙝𝙞𝙣𝙜 𝙩𝙤 𝙙𝙤…"
  </p>

  <!-- 社交按钮 (已替换为指定的 Telegram 论坛群组外链) -->
  <div class="mt-5 flex items-center gap-4">
    <a
      href="https://t.me/+KMqGQjOeRY1hNjY1"
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-pink-200 bg-pink-50 text-pink-600 shadow-sm transition-all duration-200 hover:bg-pink-300 hover:text-white active:scale-90 dark:border-purple-700 dark:bg-purple-900/60 dark:text-pink-200 dark:hover:bg-purple-700"
      aria-label="Telegram 论坛社群"
    >
      <span class="text-lg">✈️</span>
    </a>

    <a
      href="https://t.me/+KMqGQjOeRY1hNjY1"
      target="_blank"
      rel="noopener noreferrer"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-sky-200 bg-sky-50 text-sky-600 shadow-sm transition-all duration-200 hover:bg-sky-200 hover:text-sky-900 active:scale-90 dark:border-purple-700 dark:bg-purple-900/60 dark:text-sky-200 dark:hover:bg-purple-700"
      aria-label="💬 论坛"
    >
      <span class="text-lg">💬</span>
    </a>
  </div>
</div>
